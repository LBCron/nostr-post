{
  "name": "@nostr-post/posts",
  "version": "0.1.0",
  "description": "Publishing and reading nostr-post posts without a UI: bundles, replies, threads, reactions, feeds, update comments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "posts",
    "headless",
    "nip-10",
    "nip-22",
    "nip-25"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/core": "workspace:*",
    "@nostr-post/outbox": "workspace:*",
    "@nostr-post/plugins": "workspace:*",
    "@nostr-post/signer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
