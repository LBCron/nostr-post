{
  "name": "@nostr-post/outbox",
  "version": "0.1.0",
  "description": "Posts that aren't published at once: drafts, timed posts and upload later (signed now, uploaded on wifi or on request, published after)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:watch": "vitest --dir src",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nostr",
    "outbox",
    "drafts",
    "offline",
    "blossom"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nostr-post/signer": "workspace:*"
  },
  "devDependencies": {
    "@nostr-post/core": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
